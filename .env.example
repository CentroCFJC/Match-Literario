# =============================================================================
# Match Literario — variables de entorno
# =============================================================================
# Copia este archivo a `.env.local` y rellena los valores.
# Los nombres son los del prompt maestro §11.
#
# NINGUNA se usa todavía en la fase 1 (frontend + arquitectura). Las consume la
# fase 2, al conectar Google Sheets real en:
#   src/lib/data/source.ts
# -----------------------------------------------------------------------------

# --- Cuenta de servicio de Google ----------------------------------------
# Una sola service account para las dos hojas; solo cambian los permisos que se
# le den en cada archivo. Los dos valores salen del JSON de la clave.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Clave privada en una sola línea, con \n escapados y entre comillas dobles.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Los dos spreadsheets -------------------------------------------------
# El ID es el tramo entre /d/ y /edit de la URL de Google Sheets.

# "Base Autores" — la crean los organizadores. Pestañas: Autores, Actividades,
# Vocabulario. Comparte con la service account en rol LECTOR.
SHEET_AUTORES_ID=

# "Respuestas Match" — la crea el equipo de desarrollo. Pestañas: Respuestas,
# Feedback. Comparte con la service account en rol EDITOR.
SHEET_RESPUESTAS_ID=

# --- Refresco de la caché -------------------------------------------------
# Segundos que se cachea la lectura de Autores/Actividades.
SHEETS_CACHE_TTL_SECONDS=300
# Token de `POST /api/revalidate?token=...`, para forzar el refresco a mano
# cuando la curaduría corrija la hoja (una cancelación de última hora).
REVALIDATE_TOKEN=

# --- App ------------------------------------------------------------------
# Se guarda en la columna `version_app` de cada respuesta.
NEXT_PUBLIC_APP_VERSION=1.0.0
# URL pública, para armar los enlaces de compartir.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Fase 3 (panel de administración) -------------------------------------
# No es tarea de la fase 2. Se deja aquí para que el nombre no cambie después.
ADMIN_PASSWORD=
